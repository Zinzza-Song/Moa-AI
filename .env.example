# .env.example

# DB
DB_NAME=DB명
DB_USERNAME=root
DB_PASSWORD=DB 비밀번호

# Redis
REDIS_HOST=Redis host 주소
REDIS_PORT=Redis 포트

# JWT
JWT_SECRET=JWT 비밀키

# Google OAuth2
GOOGLE_CLIENT_ID=구글 api키
GOOGLE_CLIENT_SECRET=구글 api 비밀키

# Kakao OAuth2
KAKAO_CLIENT_ID=카카오 api키
KAKAO_CLIENT_SECRET=카카오 api 비밀키

# Naver OAuth2
NAVER_CLIENT_ID=네이버 api키
NAVER_CLIENT_SECRET=네이버 api 비밀키

# GEMINI
GEMINI_API_KEY=제미나이 api키
GEMINI_MODEL=gemini-3.5-flash-lite